<?xml version="1.0" encoding="utf-8"?>
<!--
    Declares the capabilities the Device Administrator can enforce.
    Only the capabilities listed here will be available to DevicePolicyManager.
-->
<device-admin>
    <uses-policies>
        <!-- Allows the app to lock the screen -->
        <force-lock />
        <!-- Allows setting a password policy -->
        <limit-password />
        <!-- Allows wiping device data (use with extreme caution) -->
        <!-- <wipe-data /> -->
        <!-- Allows monitoring screen unlock attempts -->
        <watch-login />
    </uses-policies>
</device-admin>
