<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen red lock overlay shown when payment is overdue -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lock_red">

    <!-- Top stripe accent -->
    <View
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:background="@color/lock_red_dark"
        android:layout_alignParentTop="true" />

    <!-- Bottom disclaimer (declared first so layout_above works) -->
    <TextView
        android:id="@+id/tv_disclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/lock_footer"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:paddingHorizontal="32dp" />

    <!-- Central content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_above="@id/tv_disclaimer"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <!-- Lock Icon -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_lock_check"
            android:tint="@android:color/white"
            android:layout_marginBottom="24dp" />

        <!-- Main Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/lock_heading"
            android:textColor="@android:color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Lock Message (dynamic) -->
        <TextView
            android:id="@+id/tv_lock_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/lock_message_default"
            android:textColor="#FFCCCC"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp" />

        <!-- Amount Due (shown when > 0) -->
        <TextView
            android:id="@+id/tv_amount_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#33FFFFFF"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:text="@string/amount_due_format"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="32dp" />

        <!-- Pay Now Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pay_now"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_pay_now"
            android:textColor="@color/lock_red"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@android:color/white"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Request Restore Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_request_restore"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_request_restore"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@android:color/white"
            app:strokeWidth="2dp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="24dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#44FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Section label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/label_emergency_contacts"
            android:textColor="#AAFFFFFF"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <!-- Call 911 — Emergency -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_call_911"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_call_911"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#FFCC00"
            app:cornerRadius="10dp"
            android:layout_marginBottom="8dp" />

        <!-- Call Store 1 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_call_store_1"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_call_store_1"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:backgroundTint="#33FFFFFF"
            app:strokeColor="#66FFFFFF"
            app:strokeWidth="1dp"
            app:cornerRadius="10dp"
            android:layout_marginBottom="8dp" />

        <!-- Call Store 2 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_call_store_2"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_call_store_2"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:backgroundTint="#33FFFFFF"
            app:strokeColor="#66FFFFFF"
            app:strokeWidth="1dp"
            app:cornerRadius="10dp" />

    </LinearLayout>

</RelativeLayout>
