<?xml version="1.0" encoding="utf-8"?>
<!--
    AdminAccessibilityService configuration.
    - accessibilityEventTypes: monitors window/view changes (needed to detect Settings screens)
    - accessibilityFeedbackType: Visual — required field, we won't actually produce feedback
    - canRetrieveWindowContent: true — allows reading window title to identify the screen
    - notificationTimeout: 100ms for fast response
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackVisual"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:packageNames="com.android.settings,com.samsung.android.settings,com.google.android.packageinstaller,com.android.packageinstaller" />
